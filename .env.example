POSTGRES_DB=job_resume_agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/job_resume_agent_db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176
VITE_API_BASE_URL=http://localhost:8000
# If another host process (e.g. Splunk) already binds 127.0.0.1:8000, prefer
# VITE_API_BASE_URL=http://localhost:8000 (IPv6/Docker) or set BACKEND_PORT=8001.
APP_TIMEZONE=America/Chicago

AUTO_ANALYZE_SAVED_JOBS=true
MAX_OPTIMIZATIONS_PER_RUN=3

# Local Ollama / OpenAI-compatible LLM settings
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=<your-installed-model>
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=240
LLM_MAX_RETRIES=2
ATS_GENERATION_TIMEOUT_SECONDS=300
ATS_POLL_INTERVAL_MS=2000

# When backend runs inside Docker on Windows host, connect to the host Ollama service:
# LLM_BASE_URL=http://host.docker.internal:11434/v1

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# development | production — password-reset URL is logged/exposed only in development
APP_ENV=development
FRONTEND_BASE_URL=http://localhost:5173
