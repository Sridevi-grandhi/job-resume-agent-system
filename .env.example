POSTGRES_DB=job_resume_agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/job_resume_agent_db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
APP_TIMEZONE=America/Chicago

AUTO_ANALYZE_SAVED_JOBS=true
MAX_OPTIMIZATIONS_PER_RUN=3

# Local Ollama / OpenAI-compatible LLM settings
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=<your-installed-model>
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# When backend runs inside Docker on Windows host, connect to the host Ollama service:
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# Bullet-level "Try Again" in the resume editor — deliberately independent of
# LLM_PROVIDER above (which drives FULL resume generation). Try Again always
# targets a local Ollama instance by default; leave unset to inherit
# LLM_BASE_URL/LLM_MODEL/LLM_API_KEY only when LLM_PROVIDER=openai_compatible.
# With no model configured, Try Again falls back to a safe deterministic
# rewrite rather than failing.
BULLET_REWRITE_LLM_PROVIDER=openai_compatible
BULLET_REWRITE_LLM_BASE_URL=http://localhost:11434/v1
BULLET_REWRITE_LLM_API_KEY=ollama
BULLET_REWRITE_LLM_MODEL=<your-installed-ollama-model>
BULLET_REWRITE_LLM_TEMPERATURE=0.3
BULLET_REWRITE_LLM_TIMEOUT_SECONDS=30

# When backend runs inside Docker (docker-compose), connect to the host Ollama service instead:
# BULLET_REWRITE_LLM_BASE_URL=http://host.docker.internal:11434/v1

# --- Recruiter Drafts (Email Summary) background draft-generation queue ---
# Optional. Unset/unreachable Redis degrades gracefully: Gmail scanning is
# unaffected either way, and the manual Generate Reply button still works
# (it just runs generation inline in the same request instead of via a
# background worker). Left empty by default so a fresh clone with no Redis
# running still works exactly as before.
REDIS_URL=redis://localhost:6379/0

# Recruiter Drafts' own LLM provider — independent of LLM_PROVIDER and
# BULLET_REWRITE_LLM_PROVIDER above. Leave RECRUITER_DRAFT_LLM_PROVIDER
# unset to reuse BULLET_REWRITE_LLM_PROVIDER's config as-is (same small-
# task-sized, Ollama-by-default provider) rather than configuring a third,
# separate one. Optional secondary/failover provider and rate limit below.
# RECRUITER_DRAFT_LLM_PROVIDER=openai_compatible
# RECRUITER_DRAFT_LLM_BASE_URL=http://localhost:11434/v1
# RECRUITER_DRAFT_LLM_API_KEY=ollama
# RECRUITER_DRAFT_MODEL=<your-installed-ollama-model>
# RECRUITER_DRAFT_LLM_TEMPERATURE=0.3
RECRUITER_DRAFT_TIMEOUT_SECONDS=30
RECRUITER_DRAFT_MAX_RETRIES=1
# RECRUITER_DRAFT_LLM_FAILOVER_PROVIDER=
# RECRUITER_DRAFT_LLM_FAILOVER_BASE_URL=
# RECRUITER_DRAFT_LLM_FAILOVER_API_KEY=
# RECRUITER_DRAFT_FAILOVER_MODEL=
# Redis-backed and shared across every backend instance (see
# app/services/rate_limiter.py) — a process-local counter would let a user
# exceed this just by landing on a different instance behind a load balancer.
RECRUITER_DRAFT_RATE_LIMIT_REQUESTS=10
RECRUITER_DRAFT_RATE_LIMIT_WINDOW_SECONDS=60

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# APP_ENV controls dev-only conveniences across the backend (see
# app/services/auth_email_service.is_development_environment) — set to
# "production" in any real deployment.
APP_ENV=development

# Where password-reset (and other) links point — never hardcode
# http://localhost:5173 in backend code; this is the one place it's set.
FRONTEND_BASE_URL=http://localhost:5173

# Password reset token lifetime (minutes). Existing default preserved (45).
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=45

# Local-dev-only convenience: when true (AND APP_ENV is development/dev/
# local/test), the raw password-reset URL is included in the
# forgot-password API response and briefly logged, so a developer without
# SMTP configured can still test the reset flow end to end. Both
# conditions are required — this must stay false in any real deployment;
# production never exposes the raw reset link regardless of this setting.
SHOW_DEV_RESET_LINK=false

# --- Updated Job Search: company-centric career/ATS tracker + resume matching ---
UPDATED_JOB_TRACKER_ENABLED=true
UPDATED_JOB_POLL_INTERVAL_MINUTES=15
JOB_DISCOVERY_MAX_JOBS_PER_SOURCE=100
INACTIVE_AFTER_MISSED_POLLS=3

# Off by default. When false (normal operation), a connector with no real
# company configured — or with no safe live retrieval method at all
# (Workday) — contributes NO jobs, never a fabricated one. Flip on only for
# local development/demos; even then, no "Mock Source" label is ever shown
# to users, and no real company name is ever invented.
UPDATED_JOB_DEMO_MODE=false

# --- Broad job provider: search real jobs across thousands of employers
# without manually configuring each one (see backend/app/job_sources/jsearch.py) ---
# Which BroadJobProviderAdapter fills the primary discovery slot. Only
# "jsearch" is implemented today. Greenhouse/Lever/Remotive below remain
# fully independent, optional supplemental sources regardless of this value.
UPDATED_JOB_PRIMARY_PROVIDER=jsearch

# OpenWeb Ninja JSearch API key (https://www.openwebninja.com/api/jsearch),
# sent as the `x-api-key` header — server-side only, NEVER sent to the React
# frontend. Leave as the placeholder and the provider safely contributes no
# jobs (logs JSEARCH_NOT_CONFIGURED) instead of crashing the backend.
JSEARCH_API_KEY=your_api_key_here
JSEARCH_API_BASE_URL=https://api.openwebninja.com/jsearch/search-v2

# Bounds on JSearch usage per poll cycle to stay within API quota — one
# request per distinct user-preference combination (deduplicated), not one
# per user or per page view.
JSEARCH_MAX_QUERIES_PER_POLL=8
JSEARCH_MAX_PAGES_PER_QUERY=1
JSEARCH_MAX_RETRIES=1

# Real employers to monitor via Greenhouse's public Job Board API, as
# "Company Name:board-token" pairs (comma-separated). The board token is the
# segment in https://boards.greenhouse.io/<token>. A company only ever
# appears in Updated Job Search once it is listed here AND successfully
# retrieved — nothing is hardcoded or fabricated. Optional supplemental
# source; not required for normal operation now that JSearch is primary.
# Example: GREENHOUSE_COMPANY_SOURCES=Acme Corp:acme,Example Co:example-co
GREENHOUSE_COMPANY_SOURCES=

# Real employers to monitor via Lever's public Postings API, as
# "Company Name:site-slug" pairs (comma-separated). The slug is the segment
# in https://jobs.lever.co/<slug>. Optional supplemental source; not
# required for normal operation now that JSearch is primary.
LEVER_COMPANY_SOURCES=

# Workday has no uniform public API across tenants, so this connector never
# retrieves real jobs — it only ever runs in demo mode (see
# backend/app/job_sources/workday.py).

# Off by default under the broad-provider architecture (JSearch already
# covers discovery across many real employers). Remotive's adapter code is
# NOT deleted — flip this on to also include it as a supplemental source.
UPDATED_JOB_REMOTIVE_ENABLED=false

# Off by default — enable only for demos/tests of the generic career-feed slot
# (also requires UPDATED_JOB_DEMO_MODE=true).
GENERIC_FEED_ENABLED=false

# Independent LLM provider for job-match explanations (Stage 3). Falls back
# to LLM_PROVIDER/LLM_MODEL/LLM_API_KEY above when unset, so it works out of
# the box against the same Ollama setup used by the ATS Optimizer. Set these
# to point job matching at OpenAI or Anthropic instead, without touching the
# ATS Optimizer's LLM_* configuration.
JOB_MATCH_LLM_PROVIDER=
JOB_MATCH_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Email Summary: Gmail connection (OAuth 2.0), application tracking.
# See docs/email-summary-gmail-setup.md for the full manual Google Cloud
# setup. Scope requested: gmail.readonly ONLY (read-only, current version)
# — never gmail.compose or gmail.send; CareerBoost never creates a draft or
# sends anything on your behalf. Job-related vs. unrelated mail is filtered
# entirely by this app's own classifier, not by the OAuth grant. ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email/gmail/callback

# Required to store Gmail OAuth tokens (encrypted at rest, Fernet). Generate
# once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep stable — rotating it makes previously-connected accounts' stored
# tokens undecryptable (they'll need to reconnect).
EMAIL_TOKEN_ENCRYPTION_KEY=your_generated_fernet_key_here

# Bounds on one Gmail scan — a bounded recent-messages search on first
# connection, incremental (Gmail history API) on every scan after that.
GMAIL_SCAN_MAX_MESSAGES=25
GMAIL_INITIAL_SCAN_DAYS=30
