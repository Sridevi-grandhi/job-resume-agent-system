# LLM configuration (backend only — never expose to frontend)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=240
LLM_MAX_RETRIES=2
ATS_GENERATION_TIMEOUT_SECONDS=300
ATS_POLL_INTERVAL_MS=2000

# Cap ATS optimizations started per Remotive search / resume upload / scheduler run
MAX_OPTIMIZATIONS_PER_RUN=3
