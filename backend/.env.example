# LLM configuration (backend only — never expose to frontend)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=240
LLM_MAX_RETRIES=2
ATS_GENERATION_TIMEOUT_SECONDS=300
ATS_POLL_INTERVAL_MS=2000

# Cap ATS optimizations started per Remotive search / resume upload / scheduler run
MAX_OPTIMIZATIONS_PER_RUN=3

# Recruiter Drafts background draft-generation queue — optional, degrades
# gracefully when unset/unreachable (see root .env.example for the full
# set of RECRUITER_DRAFT_* variables and draft_queue.py's module docstring).
REDIS_URL=

# Password reset (Forgot Password) — see root .env.example for
# APP_ENV / FRONTEND_BASE_URL / SHOW_DEV_RESET_LINK / SMTP_* as well.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=45

# Updated Job Search / JSearch discovery — deeper paging surfaces more
# jobs with direct employer/ATS links; the targeted lookup turns
# provider-only listings (Dice, Adzuna, LinkedIn/Indeed) into a real
# employer/ATS apply link where one exists (see app/job_sources/jsearch.py
# lookup_direct_apply). Never makes an unbounded number of calls per cycle.
JSEARCH_MAX_PAGES_PER_QUERY=2
JSEARCH_LOOKUP_MAX_PER_CYCLE=25

# Optional official company career pages; empty means no additional collection.
# Configure only public career URLs you are authorized to collect.
# JSON array: company_name, career_url, provider (auto or named), enabled.
COMPANY_CAREER_SOURCES=[]
# Optional Python Playwright + Chromium installation required; see docs/company-career-sources.md.
COMPANY_CAREER_PLAYWRIGHT_ENABLED=false
